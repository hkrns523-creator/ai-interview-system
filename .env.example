# Copy this file to .env and fill in real values.
# Never commit the actual .env file (it already is gitignored).

# Generate a fresh one for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value

# True only for local development. Must be False in production.
DEBUG=True

# Comma-separated, e.g. myapp.onrender.com,www.myapp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, with scheme, e.g. https://myapp.onrender.com
CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection
DB_NAME=interviewiq_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432